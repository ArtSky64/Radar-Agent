# VLLM_BASE_URL указан как пример, в .env указывайте актуальную ссылку
# ВАЖНО: тут указываем БАЗОВЫЙ url без /chat/completions на конце —
# OpenAIProvider сам достраивает путь. Т.е. вместо
# http://111.111.11.11:2233/v1/chat/completions пишем http://111.111.11.11:2233/v1
VLLM_BASE_URL=http://127.0.0.1:2233/v1
VLLM_MODEL_NAME=Qwen/Qwen3.6-27B
VVLM_API_KEY=not-needed

DUPLICATE_THRESHOLD=0.59
VECTOR_DIM=384

LOG_LEVEL=INFO
LOG_FILE=data/app.log
ERROR_LOG_FILE=data/errors.log

# Путь к файлу sqlite. По умолчанию app_database.db в текущей папке —
# для Docker переопределяется на /app/data/app_database.db (см. docker-compose.yml)
DB_NAME=data/app_database.db

KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here

HUGGINGFACE_API_KEY=your_huggingface_token_here

# Путь к локально склонированному https://github.com/kukapay/hf-trending-mcp
# (git clone + pip install mcp[cli] httpx) — нужен для hf_trending_fetcher.py
HF_TRENDING_MCP_PATH=/absolute/path/to/hf-trending-mcp

GITHUB_TOKEN=your_github_token_here

# PwC MCP (Streamable HTTP) & Papers settings
PWC_MCP_URL=https://gateway.pipeworx.io/paperswithcode/mcp
PWC_TRENDING_TOOL=trending_papers
PWC_DETAIL_TOOL=get_paper
PAPERS_WINDOW_DAYS=7
PAPERS_LIMIT=10